{
  "name": "morse-desktop",
  "productName": "Morse",
  "version": "1.1.5",
  "private": true,
  "description": "Morse code listening and sending practice for Mac and Windows.",
  "type": "module",
  "main": "src/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs tests/web/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "package:mac": "node scripts/package.mjs darwin arm64,x64",
    "package:windows": "node scripts/package.mjs win32 x64",
    "package:linux:test": "node scripts/package.mjs linux x64",
    "source": "node scripts/source.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:native": "node scripts/native.mjs --check",
    "staging": "node scripts/staging.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.3.2",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@electron/osx-sign": "2.7.2",
    "@electron/notarize": "3.1.2",
    "electron": "45.4.1",
    "playwright-core": "1.65.1"
  }
}
